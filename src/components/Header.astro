---
import "./../style/style.css"
import Navigation from "./Navigation.astro";
import Menu from "./Menu.astro";
import ChangeMode from "./ChangeMode.astro";
import Logo from "./Logo.astro";
const { pageTab } = Astro.props;
---

<style>
    header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 1000px;
    }
    @media (max-width: 900px) {
        header {
            width: 100%;
        }
    }
</style>
<header>
        <Logo />
        <Navigation selectedPage={pageTab}>
            <ChangeMode />
        </Navigation>
</header>
