---
import Navigation from "./Navigation.astro";
import Menu from "./Menu.astro";
import ChangeBackground from "./ChangeBackground.astro";
const { pageTab } = Astro.props;
---

<style>
    .header {
        display: flex;
        justify-content: center;
    }
</style>
<header>
    <Menu />
    <ChangeBackground />
    <Navigation selectedPage={pageTab} />
</header>
<script>
    const body = document.querySelector("body");
    const content = document.querySelector(".content");
    const modeColor = {
        darkMode: {
            backgroundColor: "black",
            textColor: "rgb(148, 163, 184)",
        },
        lightMode: {
            backgroundColor: "rgb(215, 208, 208)",
            textColor: "black",
        },
    };
    document.querySelector(".menu")?.addEventListener("click", function (e) {
        const nav = document.querySelector("header nav");
        nav.style.display = nav.style.display === "none" ? "block" : "none";
    });
    document
        .querySelector(".change-mode")
        ?.addEventListener("click", function () {
            console.log(body?.style.backgroundColor);
            if (body) {
                body.style.backgroundColor =
                    body.style.backgroundColor ===
                    modeColor.darkMode.backgroundColor
                        ? modeColor.lightMode.backgroundColor
                        : modeColor.darkMode.backgroundColor;
            }
            if (content) {
                content.style.color =
                    body.style.backgroundColor ===
                    modeColor.darkMode.backgroundColor
                        ? modeColor.darkMode.textColor
                        : " black";
            }
        });
</script>
