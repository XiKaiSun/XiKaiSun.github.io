---
import "./../utils/utils.css";
---

<style>
    button {
        width: 100%;
        height: 100%;
        min-width: 30px;
        min-height: 30px;
    }
    img {
        width: 100%;
        height: 100%;
    }
</style>

<button class="change-mode theme-btn">
    <img src="/darkmode.svg" alt="img" />
</button>
<script>
    const body = document.querySelector("body");
    const nav = document.querySelector("nav ul");
    const modeColor = {
        darkMode: {
            backgroundColor: "black",
            textColor: "rgb(148, 163, 184)",
        },
        lightMode: {
            backgroundColor: "rgb(239, 238, 216)",
            textColor: "black",
        },
    };
    const btn = document.querySelector(".change-mode");
    btn?.addEventListener("click", function () {
        if (body) {
            if (
                body.style.backgroundColor ===
                modeColor.darkMode.backgroundColor
            ) {
                body.style.backgroundColor =
                    modeColor.lightMode.backgroundColor;
                this.children[0].src = "/darkmode.svg";
            } else {
                body.style.backgroundColor = modeColor.darkMode.backgroundColor;
                this.children[0].src = "/lightmode.svg";
            }

            body.style.color =
                body.style.backgroundColor ===
                modeColor.darkMode.backgroundColor
                    ? modeColor.darkMode.textColor
                    : " black";
        }
        
    });
</script>
