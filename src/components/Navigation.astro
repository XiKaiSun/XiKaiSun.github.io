---
import "./../style/style.css";
import "./../utils/utils.css"
const { selectedPage } = Astro.props;

const tabs = [
    { href: "/", pageName: "首页" },
    { href: "/article", pageName: "文章" },
    { href: "/about", pageName: "关于" },
];
---

<style define:vars={{ selectedPage: selectedPage }}>
    nav {
        display: flex;
        justify-content: center;
        align-items: center;
    }
    nav ul {
        display: flex;
        list-style: none;
        justify-content: right;
        align-items: center;
        margin: 20px;
        gap: 30px;
    }
    nav li {
        height: 35px;
    }
    nav a{
        text-decoration:none;
    }
    a.active {
        color: red;
    }
    a:hover{
        background-color: rgb(188, 166, 166);
    }
</style>

<nav>
    <ul class="nav-font">
        {
            tabs.map((tab) => {
                if (tab.pageName === selectedPage) {
                    return (
                        <li class="flex-rc-center">
                            <a href={tab.href} class="active">
                                {tab.pageName}
                            </a>
                        </li>
                    );
                }
                return (
                    <li class="flex-rc-center">
                        <a href={tab.href}>{tab.pageName}</a>
                    </li>
                );
            })
        }
        <li class="flex-rc-center"> <slot/></li>
    </ul>
</nav>
