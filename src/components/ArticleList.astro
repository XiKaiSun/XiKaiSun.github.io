---
import dayjs from "dayjs";

let posts = Object.values(
    import.meta.glob("./../pages/article/**/*.md", { eager: true }),
);

posts.sort(
    (a, b) =>
        dayjs(b.frontmatter.pubDate).valueOf() - dayjs(a.frontmatter.pubDate).valueOf()
);
---

<style>
    .article-list {
        margin-left: 30px;
        min-width: 200px;
    }
    .article-list ul {
        display: flex;
        flex-direction: column;
    }
    .article-list ul li::marker {
        color: rgb(176, 167, 155);
    }
</style>
<div class="article-list">
    <span class="article-list-title">全部</span>
    <ul>
        {
            posts.map((article) => {
                    const articleTitle = article.frontmatter.title;
                    return (
                        <li>
                            <a href={article.url}>{articleTitle}</a>
                        </li>
                    );
                }
            )
        }
    </ul>
</div>
