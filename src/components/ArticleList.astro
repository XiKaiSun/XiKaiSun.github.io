---
import dayjs from "dayjs";

let posts = Object.values(
    import.meta.glob("./../pages/article/**/*.md", { eager: true }),
);

posts.sort(
    (a, b) =>
        dayjs(a.frontmatter.pubDate).valueOf() -
        dayjs(b.frontmatter.pubDate).valueOf(),
);
---

<style>
    .article-list {
        margin: 30px;
    }
    .article-list ul {
        list-style: none;
        display: flex;
        flex-direction: column;
    }
    .article-list ul li{
        
    }
</style>
<div class="article-list">
    <p>技术:</p>
    <ul>
        {
            posts.map((article) => {
                if (article.frontmatter.categorize.toLowerCase() === "it") {
                    const articleTitle = article.frontmatter.title;
                    return (
                        <li>
                            <a href={article.url}>{articleTitle}</a>
                        </li>
                    );
                }
            })
        }
    </ul>
    <p>生活:</p>
    <ul>
        {
            posts.map((article) => {
                if (article.frontmatter.categorize.toLowerCase() === "life") {
                    const articleTitle = article.frontmatter.title;
                    return (
                        <li>
                            <a href={article.url}>
                                {articleTitle}
                            </a>
                        </li>
                    );
                }
            })
        }
    </ul>
</div>
