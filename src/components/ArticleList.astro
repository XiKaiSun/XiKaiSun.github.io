---
import dayjs from "dayjs";

let posts = Object.values(
    import.meta.glob("./../pages/article/**/*.md", { eager: true }),
);

posts.sort(
    (a, b) =>
        dayjs(b.frontmatter.pubDate).valueOf() - dayjs(a.frontmatter.pubDate).valueOf()
);
---

<style>
    .article-list {
        margin-left: 30px;
        min-width: 200px;
    }
    .article-list ul {
        list-style: none;
        display: flex;
        flex-direction: column;
    }
</style>
<div class="article-list">
    <a href="/tags/it">技术:</a>
    <ul>
        {
            posts.map((article) => {
                if (article.frontmatter.categorize.toLowerCase() === "it") {
                    const articleTitle = article.frontmatter.title;
                    return (
                        <li>
                            <a href={article.url}>{articleTitle}</a>
                        </li>
                    );
                }
            })
        }
    </ul>
    <a href="/tags/life">生活</a>
    <ul>
        {
            posts.map((article) => {
                if (article.frontmatter.categorize.toLowerCase() === "life") {
                    const articleTitle = article.frontmatter.title;
                    return (
                        <li>
                            <a href={article.url}>{articleTitle}</a>
                        </li>
                    );
                }
            })
        }
    </ul>
</div>
