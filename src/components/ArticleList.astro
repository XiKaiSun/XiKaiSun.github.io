---
import { isFrontmatterValid } from "astro/markdown";
import dayjs from "dayjs";
import path from "path";

let posts = Object.values(
    import.meta.glob("./../pages/article/**/*.md", { eager: true }),
);

posts.sort(
    (a, b) =>
        dayjs(a.frontmatter.pubDate).valueOf() -
        dayjs(b.frontmatter.pubDate).valueOf(),
);
---

<style>
    .article-list{
        margin: 30px;
    }
    .article-list ul {
        list-style: none;
        display: flex;
        flex-direction: column;
    }
</style>
<div class="article-list">
    <p>文章列表</p>
    <p>技术:</p>
    <ul>
        {
            posts.map((article) => {
                if (article.frontmatter.categorize.toLowerCase() === "it") {
                    const articleName = article.frontmatter.title;
                    const articleUrl = articleName;
                    return (
                        <li>
                            <a href={"/article/it/" + articleUrl}>{articleName}</a>
                        </li>
                    );
                }
            })
        }
        </ul>
        <p>生活:</p>
        <ul>
            {
                posts.map((article) => {
                    if (article.frontmatter.categorize.toLowerCase() === "life") {
                        const articleName = article.frontmatter.title;
                        const articleUrl = articleName;
                        return (
                            <li>
                                <a href={"/article/life/" + articleUrl}>{articleName}</a>
                            </li>
                        );
                    }
                })
            }
        </ul>
</div>
