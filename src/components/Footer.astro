---
import Social from "./Social.astro";
const socialMedias = [{ platform: "Github", userSource: "XiKaiSun" },
{ platform: "Linkedin", userSource: "in/xikai-sun-4172751b2" },
{platform:"Email", userSource:"hello@xikaisun.com"}

];
const linkedin = "https://www.linkedin.com/in/xikai-sun-4172751b2/";
---

<style>
    .footer {
        display: flex;
        bottom: 100px;
        width: 100%;
        justify-content: center;
        margin-top: 100px;
        margin-bottom: 100px;
    }
    .footer ul{
        list-style: none;
        display: flex;
        gap: 25px;
    }
</style>
<div class="footer">
    <ul>
        {socialMedias.map(item =><li> <Social platform={item.platform} username={item.userSource}/></li>)}
    </ul>
</div>
