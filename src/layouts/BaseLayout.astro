---
import Navigation from "./../components/Navigation.astro";
import Footer from "./../components/Footer.astro";
import "./../style/style.css";
import Header from "./../components/Header.astro";
import Content from "./../components/Content.astro";
const { pageTab, pageTitle } = Astro.props;
const siteName = "XiKai Sun";
const heading = pageTitle ?? pageTab;
const documentTitle = heading ? `${heading} · ${siteName}` : siteName;
---

<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,700;1,400&display=swap"
            rel="stylesheet"
        />
        <title>{documentTitle}</title>
    </head>
    <body>
        <Header pageTab={pageTab} />
        <Content><slot /></Content>
        <Footer />
    </body>
    <script>
        import "./../js/global.js";
    </script>
</html>
