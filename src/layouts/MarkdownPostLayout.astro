---
import BaseLayout from "./BaseLayout.astro";

import Content from "../components/Content.astro";
import ArticleList from "../components/ArticleList.astro";
import dayjs from "dayjs";
import "./../style/md.css";
import "./../style/style.css";
//指定导航页选择标签
const pageTab = "文章";
//获取md 的frontmatter内容
const articlefrontmatter = Astro.props.frontmatter;
const articleId = articlefrontmatter.articleId;

//获取所有md
let posts = Object.values(
    import.meta.glob("./../pages/article/**/*.md", { eager: true }),
);
//按时间排序
posts.sort(
    (a, b) =>
        dayjs(a.frontmatter.pubDate).valueOf() -
        dayjs(b.frontmatter.pubDate).valueOf(),
);

const CurrentArticleIndex = posts.findIndex((article) => article.frontmatter.articleId === articleId);
const isFirstArticle = (CurrentArticleIndex === 0)
const isLastArticle = (CurrentArticleIndex === posts.length - 1)

let preArticle = null;
if(!isFirstArticle){
    preArticle = posts[CurrentArticleIndex - 1]
}
let nextArticle = null;
if(!isLastArticle){
    nextArticle = posts[CurrentArticleIndex + 1]

}
console.log("test info:")
console.log(nextArticle)


---

<style>
    .article-area {
       
    }

    .article-area img {
        height: 300px;
        width: 300px;
    }
</style>
<BaseLayout pageTab={pageTab}>
    <div class="flex-r-center">
        <div>
            <div>
                <ul>
                    {isFirstArticle? "" : <li ><a href={ preArticle.url }>上一篇: {preArticle.frontmatter.title}</a></li>}
                    {isLastArticle? "" : <li ><a href={nextArticle.url}>下一篇: {nextArticle.frontmatter.title}</a></li>}
                </ul>
                <div class="article-area">
                    <slot />
                </div>
            </div>
        </div>
        <div>
            <ArticleList />
        </div>
    </div>
</BaseLayout>
